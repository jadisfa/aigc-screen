import Context from 'android.content.Context'
import Uri from 'android.net.Uri'
import Bitmap from 'android.graphics.Bitmap'
import MediaMetadataRetriever from 'android.media.MediaMetadataRetriever'
import File from 'java.io.File'
import FileOutputStream from 'java.io.FileOutputStream'
import HashMap from 'java.util.HashMap'

import { ExtractVideoFrameOptions, ExtractVideoFrameResult } from '../interface.uts'
import { createErrorObject, createErrorObjectWithMsg } from '../unierror.uts'

/**
 * Android 视频抽帧。
 * - 本地绝对路径 / file:// / content://：MediaMetadataRetriever.setDataSource(Context, Uri)
 * - http(s)://：MediaMetadataRetriever.setDataSource(url, headers)
 */
export async function extractVideoFrame(options: ExtractVideoFrameOptions): Promise<ExtractVideoFrameResult> {
  return new Promise<ExtractVideoFrameResult>((resolve, reject) => {
    try {
      const url = (options.url ?? '').trim()
      if (url.length == 0) {
        reject(createErrorObject(9030002))
        return
      }

      const result = extractFrameSync(url, options)
      resolve(result)
    } catch (e) {
      reject(createErrorObjectWithMsg(9030001, e instanceof Error ? e.message : '抽帧失败'))
    }
  })
}

function extractFrameSync(url: string, options: ExtractVideoFrameOptions): ExtractVideoFrameResult {
  const retriever = new MediaMetadataRetriever()
  let bitmap: Bitmap | null = null
  let outputBitmap: Bitmap | null = null

  try {
    setRetrieverDataSource(retriever, url)

    const timeMs = getTimeMs(options)
    // 请求时间超出视频时长时钳制到时长内（留 50ms 余量），避免超时取帧失败
    let effectiveMs = timeMs
    try {
      const durationStr = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)
      if (durationStr != null) {
        const durationMs = parseFloat(durationStr!)
        const maxMs = durationMs - 50
        if (durationMs > 0 && effectiveMs > maxMs) {
          effectiveMs = Math.max(0, maxMs)
        }
      }
    } catch (_e) {}
    const timeUs = Math.max(0, Math.floor(effectiveMs * 1000)).toLong()
    bitmap = retriever.getFrameAtTime(timeUs, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)
    if (bitmap == null) {
      bitmap = retriever.getFrameAtTime(timeUs, MediaMetadataRetriever.OPTION_CLOSEST)
    }
    if (bitmap == null) {
      throw new Error('未能从视频中读取到画面')
    }

    outputBitmap = scaleBitmapIfNeed(bitmap!, options)
    const format = normalizeFormat(options.format)
    const outputFile = buildOutputFile(format, options.fileName)
    saveBitmap(outputBitmap!, outputFile, format, normalizeQuality(options.quality))

    return {
      path: 'file://' + outputFile.getAbsolutePath(),
      width: outputBitmap!.getWidth(),
      height: outputBitmap!.getHeight(),
      format: format,
      timeMs: effectiveMs,
      size: outputFile.length()
    }
  } finally {
    try {
      retriever.release()
    } catch (_e) {}
    if (outputBitmap != null && bitmap != outputBitmap) {
      outputBitmap!.recycle()
    }
    if (bitmap != null) {
      bitmap!.recycle()
    }
  }
}

function setRetrieverDataSource(retriever: MediaMetadataRetriever, url: string): void {
  const context: Context = UTSAndroid.getAppContext()!
  const lower = url.toLowerCase()

  if (lower.startsWith('http://') || lower.startsWith('https://')) {
    const headers = new HashMap<string, string>()
    retriever.setDataSource(url, headers)
    return
  }

  if (lower.startsWith('content://') || lower.startsWith('file://')) {
    retriever.setDataSource(context, Uri.parse(url))
    return
  }

  retriever.setDataSource(url)
}

function getTimeMs(options: ExtractVideoFrameOptions): number {
  if (options.timeMs != null) {
    return Math.max(0, options.timeMs!)
  }
  if (options.timeSec != null) {
    return Math.max(0, options.timeSec! * 1000)
  }
  return 0
}

function normalizeFormat(format?: string | null): string {
  const value = (format ?? 'jpg').toLowerCase()
  return value == 'png' ? 'png' : 'jpg'
}

function normalizeQuality(quality?: number | null): number {
  const value = quality ?? 90
  if (value < 1) return 1
  if (value > 100) return 100
  return Math.floor(value)
}

function buildOutputFile(format: string, fileName?: string | null): File {
  const context: Context = UTSAndroid.getAppContext()!
  const dir = new File(context.getCacheDir(), 'm-video-frame')
  if (!dir.exists()) {
    dir.mkdirs()
  }
  const safeName = sanitizeFileName(fileName)
  const name = safeName.length > 0 ? safeName : ('frame_' + Date.now().toString())
  return new File(dir, name + '.' + format)
}

function sanitizeFileName(fileName?: string | null): string {
  const value = (fileName ?? '').trim()
  if (value.length == 0) return ''
  return value.replace(new RegExp('[\\\\/:*?"<>|\\s]+', 'g'), '_').replace(new RegExp('\\.(jpg|jpeg|png)$', 'i'), '')
}

function scaleBitmapIfNeed(bitmap: Bitmap, options: ExtractVideoFrameOptions): Bitmap {
  const maxWidth = options.maxWidth ?? 0
  const maxHeight = options.maxHeight ?? 0
  if (maxWidth <= 0 && maxHeight <= 0) {
    return bitmap
  }

  const width = bitmap.getWidth()
  const height = bitmap.getHeight()
  let ratio = 1.0
  if (maxWidth > 0 && width > maxWidth) {
    ratio = Math.min(ratio, maxWidth / width)
  }
  if (maxHeight > 0 && height > maxHeight) {
    ratio = Math.min(ratio, maxHeight / height)
  }
  if (ratio >= 1.0) {
    return bitmap
  }

  const targetWidth = Math.max(1, Math.floor(width * ratio))
  const targetHeight = Math.max(1, Math.floor(height * ratio))
  return Bitmap.createScaledBitmap(bitmap, targetWidth.toInt(), targetHeight.toInt(), true)
}

function saveBitmap(bitmap: Bitmap, file: File, format: string, quality: number): void {
  const fos = new FileOutputStream(file)
  try {
    const compressFormat = format == 'png' ? Bitmap.CompressFormat.PNG : Bitmap.CompressFormat.JPEG
    const ok = bitmap.compress(compressFormat, quality.toInt(), fos)
    fos.flush()
    if (!ok || !file.exists() || file.length() <= 0) {
      throw new Error('图片保存失败')
    }
  } finally {
    fos.close()
  }
}