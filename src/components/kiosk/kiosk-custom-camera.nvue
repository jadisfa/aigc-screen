	color: #fff;
	z-index: 99999;
	margin-top: 20rpx;
}
.result-img-body {
	position: absolute;
	left: 55.55rpx;
	right: 55.55rpx;
	top: 240.7rpx;
	height: 616rpx;
	bottom: 0;
	overflow: hidden;
	/* border-style: dashed;
	border-width: 1rpx;
	border-color: #f90;
	border-radius: 70rpx; */
}
.camera-result-img {
	border-radius: 66rpx;
	position: absolute;
	top: 0;
