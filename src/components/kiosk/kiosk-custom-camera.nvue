	padding: 80rpx 120rpx;
	flex: 1;
}
.overlay-start {
	width: 130rpx;
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	background: rgba(0, 0, 0, .5);
}
.overlay-end {
	width: 130rpx;
	position: absolute;
	right: 0;
	top: 0;
	bottom: 0;
	background: rgba(0, 0, 0, .5);
}
.overlay-center {
	position: absolute;
	left: 130rpx;
	right: 130rpx;
	top: 0;
	bottom: 0;
	z-index: 9999;
}
.overlay-center-top {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 800rpx;
	background: rgba(0, 0, 0, .5);
}

.overlay-center-bottom {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	top: 640rpx;
	background: rgba(0, 0, 0, .5);
}
.overlay-bottom {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 60rpx;
	padding-bottom: 40rpx;
	padding-top: 100rpx;
	justify-content: center;
	align-items: center;
}
.overlay-center-main {
	position: absolute;
	left:0;
	bottom: 160rpx;
	right: 0;
	top: 120rpx;
}
.camera-bgimg {
	width: 100%;
	height: 100%;
}

.camera-border {
	position: absolute;
	width: 80rpx;
	height: 80rpx;
}
.countdown-text {
  font-size: 80rpx;
  font-weight: bold;
}
.capture-btn-body {
	flex-direction: column;
	justify-content: center;
	align-items: center;
}
.capture-btn-body.vector {
	margin-left: 60rpx;
}
.capture-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  background-color: #fff;
  justify-content: center;
  align-items: center;
}
.camera-icon {
	width: 60rpx;
	height: 60rpx;
}
.camera-subtitle {
	margin-top: 40rpx;
	z-index: 9000;
	color: #fff;
}
.result-bottom {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 60rpx;
	height: 250rpx;
	justify-content: space-between;
}
.result-btns {
	align-items: center;
	justify-content: center;
	flex-direction: row;
}
.result-btn-icon {
	width: 60rpx;
	height: 60rpx;
}
.result-btn-icon.close {
	width: 50rpx;
	height: 50rpx;
}
